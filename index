],
"snapshotIntro":"The charts below summarize monthly trends across users, transactions, engagement, and value metrics for the portfolio.",
"pointers":[
"Active Users: Declined from 1,674 (Jan) to a low of 1,515 (May), recovering to 1,581 in June.",
"Transactions: Followed a similar pattern, dipping through Feb/May with partial recovery to 4,515 in June.",
"Transactions per User: Stayed stable and healthy, ranging between 2.76 and 2.93 all six months.",
"Amount Paid: Grew from PKR 143M (Jan) to PKR 218M (June) \u2014 a 52% increase.",
"Average Ticket Size: Increased from ~PKR 30,400 to ~PKR 48,400, with the steepest jump Apr\u2013May.",
"User Spend: Increased in line with ticket size, from PKR 85K to PKR 138K.",
"Portfolio Revenue: Stayed largely flat at PKR 21K\u201323K/month."
]
}/*STATE_END*/;

const STORAGE_KEY = 'billPaymentsReport_v2';
const EDIT_PASSWORD = 'abhi2026'; // change this to whatever you like — required to EDIT the report
const EDIT_UNLOCK_KEY = 'billReportEditUnlocked';
const VIEW_PASSWORD = 'abhiview2026'; // change this to whatever you like — share this with anyone who should be able to VIEW the report
const VIEW_UNLOCK_KEY = 'billReportViewUnlocked';

function applyViewGate(){
  const unlocked = localStorage.getItem(VIEW_UNLOCK_KEY) === 'true';
  document.getElementById('appContent').classList.toggle('view-locked', !unlocked);
  document.getElementById('viewGateOverlay').classList.toggle('show', !unlocked);
  if(!unlocked){
    setTimeout(() => document.getElementById('viewPasswordInput').focus(), 50);
  }
}
function submitViewPassword(){
  const input = document.getElementById('viewPasswordInput');
  if(input.value === VIEW_PASSWORD){
    localStorage.setItem(VIEW_UNLOCK_KEY, 'true');
    document.getElementById('viewGateError').textContent = '';
    input.value = '';
    applyViewGate();
  } else {
    document.getElementById('viewGateError').textContent = 'Incorrect password. Please try again.';
  }
}
document.getElementById('viewSubmitBtn').addEventListener('click', submitViewPassword);
document.getElementById('viewPasswordInput').addEventListener('keydown', (e) => {
  if(e.key === 'Enter') submitViewPassword();
});
document.getElementById('lockViewLink').addEventListener('click', () => {
  localStorage.removeItem(VIEW_UNLOCK_KEY);
  applyViewGate();
});

function loadState(){
  try{
    const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
    if(raw && raw.monthly && raw.acct) return raw;
  }catch(e){}
  return JSON.parse(JSON.stringify(ORIGINAL_STATE));
}
function saveState(){
  localStorage.setItem(STORAGE_KEY, JSON.stringify({
    monthly: MONTHLY, acct: ACCT, customColumns: CUSTOM_COLUMNS, customTables: CUSTOM_TABLES,
    insights: INSIGHTS, wayForward: WAY_FORWARD, snapshotIntro: SNAPSHOT_INTRO, pointers: POINTERS
  }));
}

let state = loadState();
let MONTHLY = state.monthly;
let CUSTOM_COLUMNS = state.customColumns || [];
let ACCT = state.acct;
let CUSTOM_TABLES = state.customTables || [];
let INSIGHTS = state.insights || [];
let WAY_FORWARD = state.wayForward || [];
let SNAPSHOT_INTRO = state.snapshotIntro || '';
let POINTERS = state.pointers || [];

function esc(s){
  if(s === null || s === undefined) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function autoSize(el){
  el.style.height = 'auto';
  el.style.height = (el.scrollHeight + 2) + 'px';
}
function autoSizeAll(selector){
  document.querySelectorAll(selector).forEach(autoSize);
}
function fmtNum(v, decimals){
  if(v === null || v === undefined || isNaN(v)) return '—';
  return Number(v).toLocaleString(undefined, {minimumFractionDigits:decimals||0, maximumFractionDigits:decimals||0});
}
function fmtMoney(v){
  if(v === null || v === undefined || isNaN(v)) return '—';
  return 'Rs ' + Number(v).toLocaleString(undefined, {minimumFractionDigits:0, maximumFractionDigits:0});
}
function fmtAbbrev(v){
  if(v === null || v === undefined || isNaN(v)) return '—';
  const sign = v < 0 ? '-' : '';
  const abs = Math.abs(v);
  if(abs >= 1e9) return sign + (abs/1e9).toFixed(2) + 'B';
  if(abs >= 1e6) return sign + (abs/1e6).toFixed(1) + 'M';
  if(abs >= 1e3) return sign + (abs/1e3).toFixed(1) + 'K';
  return sign + Math.round(abs).toString();
}

function computeRow(m){
  const users = Number(m.users) || 0;
  const trxs = Number(m.trxs) || 0;
  const amount = Number(m.amount) || 0;
  const ticketSize = trxs > 0 ? amount / trxs : 0;
  const trxPerUser = users > 0 ? trxs / users : 0;
  const userSpend = users > 0 ? amount / users : 0;
  const revenue = trxs * 5;
  return {ticketSize, trxPerUser, userSpend, revenue};
}

function toggleSection(id){
  document.getElementById(id).classList.toggle('collapsed');
}

// ==================== Lock / Edit mode ====================
function applyLockState(){
  const unlocked = localStorage.getItem(EDIT_UNLOCK_KEY) === 'true';
  document.body.classList.toggle('locked', !unlocked);
  const btn = document.getElementById('unlockBtn');
  if(unlocked){
    btn.innerHTML = '&#128275; Editing Enabled (Click to Lock)';
    btn.classList.add('unlocked');
  } else {
    btn.innerHTML = '&#128274; Unlock Editing';
    btn.classList.remove('unlocked');
  }
}
document.getElementById('unlockBtn').addEventListener('click', () => {
  const unlocked = localStorage.getItem(EDIT_UNLOCK_KEY) === 'true';
  if(unlocked){
    localStorage.removeItem(EDIT_UNLOCK_KEY);
  } else {
    const pw = prompt('Enter the edit password to enable editing on this device:');
    if(pw === null) return;
    if(pw !== EDIT_PASSWORD){ alert('Incorrect password.'); return; }
    localStorage.setItem(EDIT_UNLOCK_KEY, 'true');
  }
  applyLockState();
});

// ==================== Monthly table ====================
function fixedColumns(){
  return [
    {key:'month', label:'Month', type:'text'},
    {key:'users', label:'Users', type:'number'},
    {key:'trxs', label:'Trxs', type:'number'},
    {key:'amount', label:'Amount', type:'number'},
  ];
}

function renderMonthlyHead(){
  const head = document.getElementById('monthlyHeadRow');
  let html = '';
  fixedColumns().forEach(c => html += `<th>${esc(c.label)}</th>`);
  html += `<th>Ticket Size</th><th>Trx/User</th><th>User Spend</th><th>Portfolio Revenue</th>`;
  CUSTOM_COLUMNS.forEach(c => {
    html += `<th>${esc(c.label)}<span class="col-del edit-only" onclick="deleteColumn('${c.key}')">&times;</span></th>`;
  });
  html += `<th></th>`;
  head.innerHTML = html;
}

function renderMonthly(){
  renderMonthlyHead();
  const body = document.getElementById('monthlyBody');
  body.innerHTML = MONTHLY.map((m, i) => {
    const c = computeRow(m);
    let row = `<tr>`;
    row += `<td><input class="cell-input month-input" data-idx="${i}" data-field="month" value="${esc(m.month)}"></td>`;
    row += `<td><input class="cell-input" type="number" data-idx="${i}" data-field="users" value="${m.users}"></td>`;
    row += `<td><input class="cell-input" type="number" data-idx="${i}" data-field="trxs" value="${m.trxs}"></td>`;
    row += `<td><input class="cell-input" type="number" step="0.01" data-idx="${i}" data-field="amount" value="${m.amount}"></td>`;
    row += `<td class="computed">${fmtMoney(c.ticketSize)}</td>`;
    row += `<td class="computed">${c.trxPerUser.toFixed(2)}</td>`;
    row += `<td class="computed">${fmtMoney(c.userSpend)}</td>`;
    row += `<td class="computed">${fmtNum(c.revenue)}</td>`;
    CUSTOM_COLUMNS.forEach(cc => {
      const val = (m.custom && m.custom[cc.key] !== undefined) ? m.custom[cc.key] : 0;
      row += `<td><input class="cell-input" type="number" step="any" data-idx="${i}" data-customkey="${cc.key}" value="${val}"></td>`;
    });
    row += `<td><span class="row-del edit-only" onclick="deleteMonth(${i})">&times;</span></td>`;
    row += `</tr>`;
    return row;
  }).join('');

  renderMonthlyFoot();
  bindMonthlyInputs();
  renderCharts();
  renderKpiStrip();
}

function renderMonthlyFoot(){
  const totUsers = MONTHLY.reduce((s,m) => s + (Number(m.users)||0), 0);
  const totTrxs = MONTHLY.reduce((s,m) => s + (Number(m.trxs)||0), 0);
  const totAmount = MONTHLY.reduce((s,m) => s + (Number(m.amount)||0), 0);
  const avgTicket = totTrxs > 0 ? totAmount / totTrxs : 0;
  const avgTrxUser = totUsers > 0 ? totTrxs / totUsers : 0;
  const avgUserSpend = totUsers > 0 ? totAmount / totUsers : 0;
  const totRevenue = totTrxs * 5;

  let html = `<tr><td>Total / Avg</td><td>${fmtNum(totUsers)}</td><td>${fmtNum(totTrxs)}</td><td>${fmtMoney(totAmount)}</td>`;
  html += `<td>${fmtMoney(avgTicket)}</td><td>${avgTrxUser.toFixed(2)}</td><td>${fmtMoney(avgUserSpend)}</td><td>${fmtNum(totRevenue)}</td>`;
  CUSTOM_COLUMNS.forEach(cc => {
    const total = MONTHLY.reduce((s,m) => s + (Number(m.custom && m.custom[cc.key])||0), 0);
    html += `<td>${fmtNum(total, 2)}</td>`;
  });
  html += `<td></td></tr>`;
  document.getElementById('monthlyFoot').innerHTML = html;
}

function bindMonthlyInputs(){
  document.querySelectorAll('#monthlyBody input').forEach(inp => {
    inp.addEventListener('input', () => {
      const idx = Number(inp.dataset.idx);
      if(inp.dataset.customkey){
        if(!MONTHLY[idx].custom) MONTHLY[idx].custom = {};
        MONTHLY[idx].custom[inp.dataset.customkey] = inp.value === '' ? 0 : Number(inp.value);
      } else {
        const field = inp.dataset.field;
        let val = inp.value;
        if(field !== 'month') val = val === '' ? 0 : Number(val);
        MONTHLY[idx][field] = val;
      }
      saveState();
      renderMonthlyComputedOnly();
      renderCharts();
      renderKpiStrip();
    });
  });
}

function renderMonthlyComputedOnly(){
  const rows = document.querySelectorAll('#monthlyBody tr');
  rows.forEach((tr, i) => {
    const m = MONTHLY[i];
    const c = computeRow(m);
    const tds = tr.querySelectorAll('td.computed');
    tds[0].textContent = fmtMoney(c.ticketSize);
    tds[1].textContent = c.trxPerUser.toFixed(2);
    tds[2].textContent = fmtMoney(c.userSpend);
    tds[3].textContent = fmtNum(c.revenue);
  });
  renderMonthlyFoot();
}

function deleteMonth(idx){
  if(!confirm('Remove this month row?')) return;
  MONTHLY.splice(idx, 1);
  saveState();
  renderMonthly();
}

document.getElementById('addMonthBtn').addEventListener('click', () => {
  const custom = {};
  CUSTOM_COLUMNS.forEach(c => custom[c.key] = 0);
  MONTHLY.push({month:'New', users:0, trxs:0, amount:0, custom});
  saveState();
  renderMonthly();
});

document.getElementById('addColumnBtn').addEventListener('click', () => {
  const label = prompt('New column name:');
  if(!label) return;
  const key = 'c_' + label.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'') + '_' + Date.now().toString(36);
  CUSTOM_COLUMNS.push({key, label});
  MONTHLY.forEach(m => { if(!m.custom) m.custom = {}; m.custom[key] = 0; });
  saveState();
  renderMonthly();
});

function deleteColumn(key){
  if(!confirm('Remove this column from all rows?')) return;
  CUSTOM_COLUMNS = CUSTOM_COLUMNS.filter(c => c.key !== key);
  MONTHLY.forEach(m => { if(m.custom) delete m.custom[key]; });
  saveState();
  renderMonthly();
}

// ==================== Charts (axis + gridlines + data labels) ====================
function lineChart(labels, values, color, fmt, keyId){
  const W = 340, H = 190;
  const padL = 44, padR = 16, padT = 24, padB = 26;
  const plotW = W - padL - padR;
  const plotH = H - padT - padB;
  const maxV = Math.max(...values, 0);
  const minV = Math.min(...values, 0);
  const range = (maxV - minV) || Math.abs(maxV) || 1;
  let yMax = maxV + range * 0.18;
  let yMin = minV - range * 0.18;
  if(minV >= 0 && yMin < 0) yMin = 0;
  const yRange = (yMax - yMin) || 1;

  const stepX = values.length > 1 ? plotW / (values.length - 1) : 0;
  const pts = values.map((v, i) => {
    const x = padL + i * stepX;
    const y = padT + plotH - ((v - yMin) / yRange) * plotH;
    return [x, y];
  });
  const path = pts.map((p,i) => (i===0?'M':'L') + p[0].toFixed(1) + ',' + p[1].toFixed(1)).join(' ');
  const baseline = padT + plotH;
  const areaPath = path + ` L${pts[pts.length-1][0].toFixed(1)},${baseline} L${pts[0][0].toFixed(1)},${baseline} Z`;
  const gradId = 'grad_' + (keyId || Math.random().toString(36).slice(2));

  const gridVals = [yMin, (yMin+yMax)/2, yMax];
  const gridLines = gridVals.map(v => {
    const y = padT + plotH - ((v - yMin) / yRange) * plotH;
    return `<line x1="${padL}" y1="${y.toFixed(1)}" x2="${W-padR}" y2="${y.toFixed(1)}" stroke="#E9EBEF" stroke-width="1" stroke-dasharray="3,3"/>
            <text x="${padL-6}" y="${(y+3).toFixed(1)}" font-size="9" fill="#9AA0A6" text-anchor="end">${fmt(v)}</text>`;
  }).join('');

  const xLabels = labels.map((lab, i) => {
    const x = padL + i * stepX;
    return `<text x="${x.toFixed(1)}" y="${H-8}" font-size="9.5" fill="#6B7280" text-anchor="middle">${esc(lab)}</text>`;
  }).join('');

  const dataLabels = pts.map((p,i) => {
    const labY = i>0 && values[i] < values[i-1] ? p[1] + 14 : p[1] - 8;
    return `<text x="${p[0].toFixed(1)}" y="${labY.toFixed(1)}" font-size="9.5" fill="${color}" text-anchor="middle" font-weight="700">${fmt(values[i])}</text>`;
  }).join('');

  const dots = pts.map(p => `<circle cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="3.4" fill="${color}" stroke="#fff" stroke-width="1.6"/>`).join('');

  return `<svg viewBox="0 0 ${W} ${H}">
    <defs>
      <linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${color}" stop-opacity="0.30"/>
        <stop offset="100%" stop-color="${color}" stop-opacity="0.02"/>
      </linearGradient>
    </defs>
    ${gridLines}
    <line x1="${padL}" y1="${padT}" x2="${padL}" y2="${padT+plotH}" stroke="#D9DDE3" stroke-width="1"/>
    <line x1="${padL}" y1="${padT+plotH}" x2="${W-padR}" y2="${padT+plotH}" stroke="#D9DDE3" stroke-width="1"/>
    <path d="${areaPath}" fill="url(#${gradId})" stroke="none"/>
    <path d="${path}" fill="none" stroke="${color}" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
    ${dots}
    ${dataLabels}
    ${xLabels}
  </svg>`;
}

const METRIC_DEFS = [
  {key:'revenue', label:'Portfolio Revenue', color:'#158F63', icon:'&#128176;', getVal: (m,c) => c.revenue, fmt: fmtAbbrev, full: v => fmtNum(v)},
  {key:'users', label:'Users', color:'#2E5FD9', icon:'&#128101;', getVal: m => Number(m.users)||0, fmt: fmtAbbrev, full: v => fmtNum(v)},
  {key:'trxs', label:'Transactions', color:'#158F63', icon:'&#128257;', getVal: m => Number(m.trxs)||0, fmt: fmtAbbrev, full: v => fmtNum(v)},
  {key:'amount', label:'Amount', color:'#B4791E', icon:'&#128181;', getVal: m => Number(m.amount)||0, fmt: fmtAbbrev, full: v => fmtMoney(v)},
  {key:'ticketSize', label:'Ticket Size', color:'#7C4FC7', icon:'&#127915;', getVal: (m,c) => c.ticketSize, fmt: fmtAbbrev, full: v => fmtMoney(v)},
  {key:'trxPerUser', label:'Trx / User', color:'#C6394A', icon:'&#128260;', getVal: (m,c) => c.trxPerUser, fmt: v => v.toFixed(2), full: v => v.toFixed(2)},
  {key:'userSpend', label:'User Spend', color:'#2E5FD9', icon:'&#128717;', getVal: (m,c) => c.userSpend, fmt: fmtAbbrev, full: v => fmtMoney(v)},
];

function renderKpiStrip(){
  const strip = document.getElementById('kpiStrip');
  if(MONTHLY.length === 0){ strip.innerHTML = ''; return; }
  const computedRows = MONTHLY.map(m => computeRow(m));
  const last = MONTHLY.length - 1;
  const prev = last - 1;

  const tiles = [
    {label:'Active Users', icon:'&#128101;', val: Number(MONTHLY[last].users)||0, prevVal: prev>=0 ? Number(MONTHLY[prev].users)||0 : null, fmt: fmtNum},
    {label:'Transactions', icon:'&#128257;', val: Number(MONTHLY[last].trxs)||0, prevVal: prev>=0 ? Number(MONTHLY[prev].trxs)||0 : null, fmt: fmtNum},
    {label:'Amount Paid', icon:'&#128181;', val: Number(MONTHLY[last].amount)||0, prevVal: prev>=0 ? Number(MONTHLY[prev].amount)||0 : null, fmt: fmtMoney},
    {label:'Portfolio Revenue', icon:'&#128176;', val: computedRows[last].revenue, prevVal: prev>=0 ? computedRows[prev].revenue : null, fmt: fmtNum},
  ];

  strip.innerHTML = tiles.map(t => {
    let deltaHtml = '';
    if(t.prevVal !== null && t.prevVal !== 0){
      const pct = ((t.val - t.prevVal) / Math.abs(t.prevVal)) * 100;
      const dir = pct > 0.05 ? 'up' : (pct < -0.05 ? 'down' : 'flat');
      const arrow = dir === 'up' ? '&#9650;' : (dir === 'down' ? '&#9660;' : '&#9679;');
      deltaHtml = `<div class="kpi-delta ${dir}">${arrow} ${Math.abs(pct).toFixed(1)}% MoM</div>`;
    }
    return `
      <div class="kpi-tile">
        <span class="kpi-icon">${t.icon}</span>
        <div class="kpi-label">${esc(t.label)}</div>
        <div class="kpi-value">${t.fmt(t.val)}</div>
        ${deltaHtml}
      </div>`;
  }).join('');
}

function renderCharts(){
  const months = MONTHLY.map(m => m.month);
  const computedRows = MONTHLY.map(m => computeRow(m));

  const grid = document.getElementById('chartGrid');
  grid.innerHTML = METRIC_DEFS.map(def => {
    const values = MONTHLY.map((m,i) => def.getVal(m, computedRows[i]));
    const latest = values.length ? values[values.length-1] : 0;
    const latestMonth = months.length ? months[months.length-1] : '';
    return `
      <div class="chart-card" style="--accent:${def.color}">
        <div class="chart-title"><span class="chart-icon">${def.icon}</span>${esc(def.label)}</div>
        <div class="chart-latest">${esc(latestMonth)}: ${def.full(latest)}</div>
        ${lineChart(months, values, def.color, def.fmt, def.key)}
      </div>`;
  }).join('');
}

// ==================== Account type table + bars ====================
function renderAcct(){
  const body = document.getElementById('acctBody');
  body.innerHTML = ACCT.map((a, i) => `
    <tr>
      <td><input class="cell-input" data-idx="${i}" data-field="type" value="${esc(a.type)}"></td>
      <td><input class="cell-input" type="number" data-idx="${i}" data-field="count" value="${a.count}"></td>
      <td><span class="row-del edit-only" onclick="deleteAcct(${i})">&times;</span></td>
    </tr>`).join('');

  const total = ACCT.reduce((s,a) => s + (Number(a.count)||0), 0);
  document.getElementById('acctFoot').innerHTML = `<tr><td>Grand Total</td><td>${fmtNum(total)}</td><td></td></tr>`;

  document.querySelectorAll('#acctBody input').forEach(inp => {
    inp.addEventListener('input', () => {
      const idx = Number(inp.dataset.idx);
      const field = inp.dataset.field;
      let val = inp.value;
      if(field === 'count') val = val === '' ? 0 : Number(val);
      ACCT[idx][field] = val;
      saveState();
      renderAcctBarsAndTotal();
    });
  });

  renderAcctBars();
}

function renderAcctBarsAndTotal(){
  const total = ACCT.reduce((s,a) => s + (Number(a.count)||0), 0);
  document.getElementById('acctFoot').innerHTML = `<tr><td>Grand Total</td><td>${fmtNum(total)}</td><td></td></tr>`;
  renderAcctBars();
}

function renderAcctBars(){
  const maxCount = Math.max(1, ...ACCT.map(a => Number(a.count)||0));
  const list = document.getElementById('acctBarList');
  const sorted = [...ACCT].sort((a,b) => (Number(b.count)||0) - (Number(a.count)||0));
  list.innerHTML = sorted.map(a => {
    const pct = ((Number(a.count)||0) / maxCount) * 100;
    return `
      <div class="bar-row">
        <div class="bar-label" title="${esc(a.type)}">${esc(a.type)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
        <div class="bar-total">${fmtNum(a.count)}</div>
      </div>`;
  }).join('');
}

function deleteAcct(idx){
  if(!confirm('Remove this account type row?')) return;
  ACCT.splice(idx, 1);
  saveState();
  renderAcct();
}

document.getElementById('addAcctBtn').addEventListener('click', () => {
  ACCT.push({type:'New Type', count:0});
  saveState();
  renderAcct();
});

