// ==================== Custom tables ====================
function addCustomTable(){
  const title = prompt('Table name:', 'New Table');
  if(!title) return;
  const id = 'tbl_' + Date.now().toString(36);
  CUSTOM_TABLES.push({
    id, title,
    columns: [{key:'label', label:'Label'}, {key:'value', label:'Value'}],
    rows: [{label:'Item 1', value: 0}],
    showChart: true
  });
  saveState();
  renderCustomTables();
}
document.getElementById('addTableBtn').addEventListener('click', addCustomTable);

function deleteCustomTable(id){
  if(!confirm('Delete this entire table?')) return;
  CUSTOM_TABLES = CUSTOM_TABLES.filter(t => t.id !== id);
  saveState();
  renderCustomTables();
}

function addCustomTableRow(tableId){
  const t = CUSTOM_TABLES.find(t => t.id === tableId);
  if(!t) return;
  const row = {};
  t.columns.forEach(c => row[c.key] = c.key === 'label' ? 'New Item' : 0);
  t.rows.push(row);
  saveState();
  renderCustomTables();
}
function deleteCustomTableRow(tableId, idx){
  const t = CUSTOM_TABLES.find(t => t.id === tableId);
  if(!t) return;
  t.rows.splice(idx, 1);
  saveState();
  renderCustomTables();
}
function addCustomTableColumn(tableId){
  const t = CUSTOM_TABLES.find(t => t.id === tableId);
  if(!t) return;
  const label = prompt('New column name:');
  if(!label) return;
  const key = 'c_' + label.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'') + '_' + Date.now().toString(36);
  t.columns.push({key, label});
  t.rows.forEach(r => r[key] = 0);
  saveState();
  renderCustomTables();
}
function deleteCustomTableColumn(tableId, key){
  const t = CUSTOM_TABLES.find(t => t.id === tableId);
  if(!t) return;
  if(t.columns.length <= 1) { alert('A table needs at least one column.'); return; }
  t.columns = t.columns.filter(c => c.key !== key);
  t.rows.forEach(r => delete r[key]);
  saveState();
  renderCustomTables();
}
function toggleCustomTableChart(tableId){
  const t = CUSTOM_TABLES.find(t => t.id === tableId);
  if(!t) return;
  t.showChart = !t.showChart;
  saveState();
  renderCustomTables();
}
function renameCustomTable(tableId, newTitle){
  const t = CUSTOM_TABLES.find(t => t.id === tableId);
  if(!t) return;
  t.title = newTitle;
  saveState();
}

function firstNumericColumn(t){
  return t.columns.find(c => c.key !== 'label') || t.columns[0];
}
function labelColumn(t){
  return t.columns.find(c => c.key === 'label') || t.columns[0];
}

function renderCustomTables(){
  const host = document.getElementById('customTablesHost');
  host.innerHTML = CUSTOM_TABLES.map(t => {
    const labelCol = labelColumn(t);
    const numCol = firstNumericColumn(t);
    const headHtml = t.columns.map(c =>
      `<th>${esc(c.label)}${t.columns.length>1 ? `<span class="col-del edit-only" onclick="deleteCustomTableColumn('${t.id}','${c.key}')">&times;</span>` : ''}</th>`
    ).join('') + '<th></th>';
    const bodyHtml = t.rows.map((r, i) => {
      const cells = t.columns.map(c => {
        const isNum = c.key !== 'label';
        return `<td><input class="cell-input" type="${isNum?'number':'text'}" ${isNum?'step="any"':''} data-row="${i}" data-key="${c.key}" value="${esc(r[c.key])}"></td>`;
      }).join('');
      return `<tr>${cells}<td><span class="row-del edit-only" onclick="deleteCustomTableRow('${t.id}',${i})">&times;</span></td></tr>`;
    }).join('');

    const chartHtml = (t.showChart && numCol)
      ? `<div class="bar-list" id="chart_${t.id}" style="margin-top:14px;">${buildCustomTableBars(t)}</div>`
      : '';

    return `
      <div class="custom-table-block" data-table-id="${t.id}">
        <div class="ctb-header">
          <input class="ctb-title-input" value="${esc(t.title)}" onchange="renameCustomTable('${t.id}', this.value)">
          <label class="edit-only" style="font-size:12px;color:var(--muted);display:flex;align-items:center;gap:5px;white-space:nowrap;">
            <input type="checkbox" ${t.showChart?'checked':''} onchange="toggleCustomTableChart('${t.id}')"> Show chart
          </label>
          <span class="mini-btn danger edit-only" style="margin:0;padding:5px 10px;" onclick="deleteCustomTable('${t.id}')">Delete Table</span>
        </div>
        <div class="table-scroll">
        <table><thead><tr>${headHtml}</tr></thead><tbody>${bodyHtml}</tbody></table>
        </div>
        <button class="mini-btn edit-only" onclick="addCustomTableRow('${t.id}')">+ Add Row</button>
        <button class="mini-btn edit-only" onclick="addCustomTableColumn('${t.id}')">+ Add Column</button>
        ${chartHtml}
      </div>`;
  }).join('') || '<div style="color:var(--muted);font-size:13px;">No custom tables yet — click "+ New Table" to add your own data and chart.</div>';

  host.querySelectorAll('.custom-table-block').forEach(block => {
    const tableId = block.dataset.tableId;
    const t = CUSTOM_TABLES.find(t => t.id === tableId);
    block.querySelectorAll('input.cell-input[data-row]').forEach(inp => {
      inp.addEventListener('input', () => {
        const rIdx = Number(inp.dataset.row);
        const key = inp.dataset.key;
        const isNum = key !== 'label';
        t.rows[rIdx][key] = isNum ? (inp.value === '' ? 0 : Number(inp.value)) : inp.value;
        saveState();
        if(t.showChart){
          const chartEl = document.getElementById('chart_' + t.id);
          if(chartEl) chartEl.innerHTML = buildCustomTableBars(t);
        }
      });
    });
  });
}

function buildCustomTableBars(t){
  const labelCol = labelColumn(t);
  const numCol = firstNumericColumn(t);
  if(!numCol) return '';
  const maxV = Math.max(1, ...t.rows.map(r => Number(r[numCol.key])||0));
  const sorted = [...t.rows].sort((a,b) => (Number(b[numCol.key])||0) - (Number(a[numCol.key])||0));
  return sorted.map(r => {
    const pct = ((Number(r[numCol.key])||0) / maxV) * 100;
    return `<div class="bar-row">
      <div class="bar-label" title="${esc(r[labelCol.key])}">${esc(r[labelCol.key])}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
      <div class="bar-total">${fmtNum(r[numCol.key])}</div>
    </div>`;
  }).join('');
}

// ==================== Toolbar: Export / Reset / Publish ====================
document.getElementById('resetBtn').addEventListener('click', () => {
  if(confirm('This will discard all edits and restore the original report data. Continue?')){
    const fresh = JSON.parse(JSON.stringify(ORIGINAL_STATE));
    MONTHLY = fresh.monthly; CUSTOM_COLUMNS = fresh.customColumns; ACCT = fresh.acct;
    CUSTOM_TABLES = fresh.customTables; INSIGHTS = fresh.insights; WAY_FORWARD = fresh.wayForward;
    SNAPSHOT_INTRO = fresh.snapshotIntro; POINTERS = fresh.pointers;
    saveState();
    renderAll();
  }
});

document.getElementById('exportBtn').addEventListener('click', () => {
  const headers = ['Month','Users','Trxs','Amount','Ticket Size','Trx/User','User Spend','Portfolio Revenue', ...CUSTOM_COLUMNS.map(c=>c.label)];
  const rows = [headers.join(',')];
  MONTHLY.forEach(m => {
    const c = computeRow(m);
    const base = [m.month, m.users, m.trxs, m.amount, c.ticketSize.toFixed(2), c.trxPerUser.toFixed(4), c.userSpend.toFixed(2), c.revenue];
    const customVals = CUSTOM_COLUMNS.map(cc => (m.custom && m.custom[cc.key]) || 0);
    rows.push([...base, ...customVals].map(v => '"' + String(v).replace(/"/g,'""') + '"').join(','));
  });
  rows.push('');
  rows.push('Account Type,Count');
  ACCT.forEach(a => rows.push(`"${String(a.type).replace(/"/g,'""')}",${a.count}`));

  CUSTOM_TABLES.forEach(t => {
    rows.push('');
    rows.push(`"${t.title.replace(/"/g,'""')}"`);
    rows.push(t.columns.map(c => `"${c.label.replace(/"/g,'""')}"`).join(','));
    t.rows.forEach(r => rows.push(t.columns.map(c => `"${String(r[c.key]).replace(/"/g,'""')}"`).join(',')));
  });

  const blob = new Blob([rows.join('\n')], {type:'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'bill_payments_report_export.csv';
  a.click();
  URL.revokeObjectURL(url);
});

document.getElementById('publishBtn').addEventListener('click', () => {
  if(!confirm('This downloads a new index.html with all current data, tables, and text baked in as the new baseline.\n\nRe-upload this file to your host (replacing index.html) to make everything visible to everyone.\n\nContinue?')) return;

  const newState = {
    monthly: MONTHLY, acct: ACCT, customColumns: CUSTOM_COLUMNS, customTables: CUSTOM_TABLES,
    insights: INSIGHTS, wayForward: WAY_FORWARD, snapshotIntro: SNAPSHOT_INTRO, pointers: POINTERS
  };
  const newJson = JSON.stringify(newState).replace(/\$/g, '$$$$');

  let html = '<!doctype html>\n' + document.documentElement.outerHTML;
  html = html.replace(/\/\*STATE_START\*\/[\s\S]*?\/\*STATE_END\*\//, '/*STATE_START*/' + newJson + '/*STATE_END*/');

  const blob = new Blob([html], {type:'text/html'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'index.html';
  a.click();
  URL.revokeObjectURL(url);
});

// ==================== Init ====================
function renderAll(){
  renderInsights();
  renderWayForward();
  renderPointers();
  renderSnapshotIntro();
  renderMonthly(); // also calls renderCharts
  renderAcct();
  renderCustomTables();
}

applyLockState();
applyViewGate();
renderAll();
</script>
</body>
</html>
