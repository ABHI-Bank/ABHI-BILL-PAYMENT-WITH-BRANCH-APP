<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bill Payments — Interactive Performance Report</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#1F3864; --navy-deep:#0F1E36; --navy-mid:#2E4E8C;
    --gold:#B08D57; --gold-bright:#E3BD82;
    --bg:#F3F5FA; --card:#FFFFFF; --border:#E7E9F0; --text:#242B38; --muted:#6C7486;
    --green:#158F63; --green-bg:#E4F5EE;
    --blue:#2E5FD9; --blue-bg:#E8EEFC;
    --amber:#B4791E; --amber-bg:#FBF0DC;
    --purple:#7C4FC7; --purple-bg:#F1E9FB;
    --red:#C6394A; --red-bg:#FBE7EA;
    --shadow: 0 1px 2px rgba(15,30,54,0.04), 0 6px 20px rgba(15,30,54,0.06);
    --shadow-hover: 0 4px 10px rgba(15,30,54,0.06), 0 14px 32px rgba(15,30,54,0.10);
    --font-display: 'Manrope', 'Segoe UI', Arial, sans-serif;
    --font-body: 'Inter', 'Segoe UI', Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:var(--font-body);background:var(--bg);color:var(--text);}

  header{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-mid) 100%);color:#fff;padding:26px 28px 22px 28px;
    position:relative;border-bottom:3px solid var(--gold);}
  header h1{margin:0 0 5px 0;font-size:24px;font-family:var(--font-display);font-weight:800;letter-spacing:-0.2px;}
  header .sub{font-size:13px;opacity:0.85;}

  .toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;background:var(--card);padding:14px 28px;
    border-bottom:1px solid var(--border);position:sticky;top:0;z-index:20;box-shadow:0 2px 8px rgba(15,30,54,0.04);}
  .toolbar button{padding:9px 16px;border-radius:8px;border:1px solid var(--navy);background:var(--navy);color:#fff;
    font-size:13px;cursor:pointer;font-weight:600;font-family:var(--font-body);transition:all 0.15s ease;}
  .toolbar button.secondary{background:#fff;color:var(--navy);}
  .toolbar button:hover{opacity:0.9;transform:translateY(-1px);box-shadow:0 4px 10px rgba(15,30,54,0.12);}
  #unlockBtn.unlocked{background:var(--green);color:#fff;border-color:var(--green);}

  main{padding:20px 28px 50px 28px;max-width:1400px;margin:0 auto;}

  .section{background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:24px;overflow:hidden;
    box-shadow:var(--shadow);}
  .section-header{display:flex;align-items:center;gap:12px;padding:16px 20px;cursor:pointer;
    background:linear-gradient(to right, #FAFBFD, #ffffff);
    border-bottom:1px solid var(--border);user-select:none;}
  .section-header:hover{background:#F1F4F8;}
  .section-header .chevron{transition:transform 0.15s ease;font-size:12px;color:var(--navy);width:14px;}
  .section.collapsed .chevron{transform:rotate(-90deg);}
  .section-header .icon-badge{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;
    font-size:17px;flex-shrink:0;}
  .section-header .title{font-weight:800;color:var(--navy);font-size:16px;flex:1;font-family:var(--font-display);letter-spacing:-0.1px;}
  .section-header .title .num{color:var(--gold);margin-right:6px;}
  .section-body{padding:20px 22px;}
  .section.collapsed .section-body{display:none;}

  #snapshotSection .icon-badge{background:var(--blue-bg);}
  #monthlySection .icon-badge{background:var(--navy);color:#fff;}
  #insightsSection .icon-badge{background:var(--amber-bg);}
  #wayForwardSection .icon-badge{background:var(--green-bg);}
  #acctSection .icon-badge{background:var(--purple-bg);}
  #customSection .icon-badge{background:var(--red-bg);}

  table{width:100%;border-collapse:collapse;font-size:13px;}
  thead th{text-align:left;padding:9px 10px;background:#fff;border-bottom:2px solid var(--border);
    color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:0.4px;white-space:nowrap;}
  thead th .col-del{color:var(--red);cursor:pointer;margin-left:6px;font-weight:700;text-transform:none;}
  tbody td{padding:7px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}
  tbody tr:hover{background:#FAFBFC;}
  tbody td.computed{color:var(--navy);font-weight:600;background:#F7F9FC;}
  tfoot td{padding:9px 10px;font-weight:700;border-top:2px solid var(--border);background:#FAFBFC;}

  input.cell-input{width:100%;min-width:70px;padding:5px 7px;border:1px solid var(--border);border-radius:5px;
    font-size:13px;font-family:inherit;}
  input.cell-input.month-input{min-width:60px;font-weight:600;}

  .row-del{cursor:pointer;color:var(--red);font-weight:700;padding:0 6px;}
  .row-del:hover{opacity:0.7;}

  .add-row-btn, .mini-btn{padding:7px 14px;border-radius:7px;border:1px solid var(--navy);background:#fff;
    color:var(--navy);font-size:12.5px;cursor:pointer;font-weight:600;margin-top:10px;margin-right:8px;}
  .add-row-btn:hover, .mini-btn:hover{background:#F1F4F8;}
  .mini-btn.danger{border-color:var(--red);color:var(--red);}

  .table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}
  .table-scroll table{min-width:680px;}
  .acct-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;}

  .chart-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;}
  .chart-card{border:1px solid var(--border);border-radius:12px;padding:16px 18px 14px 18px;background:#FFFFFF;
    box-shadow:var(--shadow);transition:box-shadow 0.2s ease, transform 0.2s ease;position:relative;overflow:hidden;}
  .chart-card:hover{box-shadow:var(--shadow-hover);transform:translateY(-2px);}
  .chart-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--accent, var(--navy));}
  .chart-card .chart-title{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:2px;font-family:var(--font-display);
    display:flex;align-items:center;gap:7px;}
  .chart-card .chart-icon{font-size:15px;}
  .chart-card .chart-latest{font-size:12px;color:var(--muted);margin-bottom:8px;font-weight:500;}
  .chart-card svg{width:100%;height:190px;overflow:visible;}
  textarea.note-input{width:100%;margin-top:8px;padding:7px 9px;border:1px solid var(--border);border-radius:6px;
    font-size:12px;font-family:inherit;color:var(--text);resize:vertical;min-height:44px;line-height:1.4;}

  .bar-list .bar-row{display:flex;align-items:center;gap:10px;margin-bottom:9px;}
  .bar-list .bar-label{width:230px;flex-shrink:0;font-size:12.5px;color:var(--text);white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis;}
  .bar-list .bar-track{flex:1;height:18px;background:#EDEFF2;border-radius:4px;overflow:hidden;max-width:400px;}
  .bar-list .bar-fill{height:100%;background:var(--blue);border-radius:4px;}
  .bar-list .bar-total{width:60px;flex-shrink:0;font-size:12px;color:var(--muted);font-weight:600;text-align:right;}

  .bullet-list{margin:0;padding:0;list-style:none;}
  .bullet-row{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px;}
  .bullet-row .bullet-dot{width:24px;height:24px;border-radius:50%;background:var(--gold);color:#fff;
    font-size:11.5px;font-weight:800;line-height:24px;text-align:center;flex-shrink:0;margin-top:2px;
    font-family:var(--font-display);}
  #wayForwardList .bullet-dot{background:var(--green);}
  #pointersList .bullet-dot{background:var(--blue);}
  textarea.bullet-input{flex:1;padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;
    font-family:inherit;color:var(--text);resize:vertical;min-height:44px;line-height:1.45;}
  textarea.intro-input{width:100%;padding:9px 11px;border:1px solid var(--border);border-radius:6px;font-size:13.5px;
    font-family:inherit;color:var(--text);resize:vertical;min-height:50px;line-height:1.5;margin-bottom:14px;}

  .custom-table-block{border:1px solid var(--border);border-radius:8px;padding:14px 16px;margin-bottom:16px;background:#FCFCFD;}
  .custom-table-block .ctb-header{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
  .custom-table-block .ctb-title-input{font-size:14px;font-weight:700;color:var(--navy);border:1px solid transparent;
    border-radius:6px;padding:4px 8px;flex:1;background:transparent;}
  .custom-table-block .ctb-title-input:hover, .custom-table-block .ctb-title-input:focus{border-color:var(--border);background:#fff;}

  /* Lock / view-only mode: inputs render as plain read-only text, edit-only controls disappear */
  body.locked input.cell-input, body.locked textarea.bullet-input, body.locked textarea.note-input,
  body.locked textarea.intro-input, body.locked .ctb-title-input{
    border:1px solid transparent !important; background:transparent !important; pointer-events:none;
    resize:none; color:inherit; padding-left:0;
  }
  body.locked .edit-only{display:none !important;}

  footer{text-align:center;padding:20px;color:var(--muted);font-size:12px;}

  .pointers-block{margin-top:18px;padding-top:16px;border-top:1px solid var(--border);}
  .pointers-title{font-size:13px;font-weight:700;color:var(--navy);margin-bottom:10px;}

  .kpi-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
  .kpi-tile{background:linear-gradient(145deg,#ffffff,#F7F9FD);border:1px solid var(--border);border-radius:12px;
    padding:16px 18px;box-shadow:var(--shadow);position:relative;overflow:hidden;}
  .kpi-tile .kpi-icon{position:absolute;right:14px;top:14px;font-size:22px;opacity:0.55;}
  .kpi-tile .kpi-label{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;font-weight:600;margin-bottom:6px;}
  .kpi-tile .kpi-value{font-size:24px;font-weight:800;color:var(--navy);font-family:var(--font-display);letter-spacing:-0.3px;}
  .kpi-tile .kpi-delta{font-size:12px;font-weight:700;margin-top:5px;display:inline-flex;align-items:center;gap:3px;}
  .kpi-tile .kpi-delta.up{color:var(--green);}
  .kpi-tile .kpi-delta.down{color:var(--red);}
  .kpi-tile .kpi-delta.flat{color:var(--muted);}

  @media (max-width: 900px){
    .kpi-strip{grid-template-columns:repeat(2,1fr);}
  }
  @media (max-width: 640px){
    .kpi-strip{grid-template-columns:1fr 1fr;gap:10px;}
    .kpi-tile{padding:12px 14px;}
    .kpi-tile .kpi-value{font-size:19px;}
  }

  @media (max-width: 640px){
    header{padding:16px 14px;} header h1{font-size:18px;}
    .toolbar{padding:10px 14px;} main{padding:14px 14px 30px 14px;}
    .bar-list .bar-label{width:130px;font-size:11.5px;}
    .acct-grid{grid-template-columns:1fr;}
    .chart-grid{grid-template-columns:1fr;}
  }

  #appContent{transition:filter 0.3s ease;}
  #appContent.view-locked{filter:blur(14px);pointer-events:none;user-select:none;}

  .view-gate-overlay{position:fixed;inset:0;background:rgba(15,30,54,0.45);display:none;
    align-items:center;justify-content:center;z-index:1000;padding:20px;}
  .view-gate-overlay.show{display:flex;}
  .view-gate-card{background:#fff;border-radius:16px;padding:38px 36px;box-shadow:var(--shadow-hover);
    text-align:center;max-width:340px;width:100%;}
  .view-gate-icon{font-size:36px;margin-bottom:12px;}
  .view-gate-card h2{margin:0 0 6px 0;color:var(--navy);font-family:var(--font-display);font-size:21px;font-weight:800;}
  .view-gate-card p{color:var(--muted);font-size:13px;margin:0 0 20px 0;}
  #viewPasswordInput{width:100%;padding:11px 13px;border:1px solid var(--border);border-radius:9px;font-size:14px;
    margin-bottom:14px;font-family:inherit;box-sizing:border-box;}
  #viewSubmitBtn{width:100%;padding:11px;border-radius:9px;border:none;background:var(--navy);color:#fff;
    font-weight:700;cursor:pointer;font-size:14px;font-family:var(--font-body);transition:opacity 0.15s ease;}
  #viewSubmitBtn:hover{opacity:0.9;}
  .view-gate-error{color:var(--red);font-size:12.5px;margin-top:12px;min-height:16px;font-weight:600;}
</style>
</head>
<body>

<div class="view-gate-overlay" id="viewGateOverlay">
  <div class="view-gate-card">
    <div class="view-gate-icon">&#128274;</div>
    <h2>Monthly Performance Report - Bill Payments</h2>
    <p>Enter the password to view this report.</p>
    <input type="password" id="viewPasswordInput" placeholder="Password" autocomplete="off">
    <button id="viewSubmitBtn">View Report</button>
    <div class="view-gate-error" id="viewGateError"></div>
  </div>
</div>

<div id="appContent">

<header>
  <h1>Bill Payments — Interactive Performance Report</h1>
  <div class="sub">Enter new figures and every metric, table, and chart recalculates automatically</div>
</header>

<div class="toolbar">
  <button class="secondary" id="unlockBtn">&#128274; Unlock Editing</button>
  <button class="secondary edit-only" id="publishBtn" title="Downloads a new index.html with everything baked in — re-upload it to make changes visible to everyone">Publish Updated Site</button>
  <button class="secondary" id="exportBtn">Export CSV</button>
  <button class="secondary edit-only" id="resetBtn">Reset to Original Data</button>
</div>

<main>

  <div class="section" id="snapshotSection">
    <div class="section-header" onclick="toggleSection('snapshotSection')">
      <span class="chevron">&#9660;</span>
      <span class="icon-badge">&#128202;</span>
      <span class="title">Performance Metrics</span>
    </div>
    <div class="section-body">
      <div class="kpi-strip" id="kpiStrip"></div>
      <textarea class="intro-input" id="snapshotIntro"></textarea>
      <div class="chart-grid" id="chartGrid"></div>
      <div class="pointers-block">
        <div class="pointers-title">Summary</div>
        <ul class="bullet-list" id="pointersList"></ul>
        <button class="add-row-btn edit-only" id="addPointerBtn">+ Add Point</button>
      </div>
    </div>
  </div>

  <div class="section" id="monthlySection">
    <div class="section-header" onclick="toggleSection('monthlySection')">
      <span class="chevron">&#9660;</span>
      <span class="icon-badge">&#128197;</span>
      <span class="title">Monthly Performance</span>
    </div>
    <div class="section-body">
      <div class="table-scroll">
      <table>
        <thead><tr id="monthlyHeadRow"></tr></thead>
        <tbody id="monthlyBody"></tbody>
        <tfoot id="monthlyFoot"></tfoot>
      </table>
      </div>
      <button class="add-row-btn edit-only" id="addMonthBtn">+ Add Month</button>
      <button class="add-row-btn edit-only" id="addColumnBtn">+ Add Column</button>
      <div style="font-size:11.5px;color:var(--muted);margin-top:10px;line-height:1.6;">
        <b>Formulas</b> — Ticket Size = Amount / Trxs &nbsp;|&nbsp; Trx/User = Trxs / Users &nbsp;|&nbsp;
        User Spend = Amount / Users &nbsp;|&nbsp; Portfolio Revenue = Trxs &times; 5 &nbsp;|&nbsp;
        Added columns are plain editable values (no auto-formula).
      </div>
    </div>
  </div>

  <div class="section" id="insightsSection">
    <div class="section-header" onclick="toggleSection('insightsSection')">
      <span class="chevron">&#9660;</span>
      <span class="icon-badge">&#128161;</span>
      <span class="title">Key Insights</span>
    </div>
    <div class="section-body">
      <ul class="bullet-list" id="insightsList"></ul>
      <button class="add-row-btn edit-only" id="addInsightBtn">+ Add Point</button>
    </div>
  </div>

  <div class="section" id="wayForwardSection">
    <div class="section-header" onclick="toggleSection('wayForwardSection')">
      <span class="chevron">&#9660;</span>
      <span class="icon-badge">&#128640;</span>
      <span class="title">Way Forward</span>
    </div>
    <div class="section-body">
      <ul class="bullet-list" id="wayForwardList"></ul>
      <button class="add-row-btn edit-only" id="addWayForwardBtn">+ Add Point</button>
    </div>
  </div>

  <div class="section" id="acctSection">
    <div class="section-header" onclick="toggleSection('acctSection')">
      <span class="chevron">&#9660;</span>
      <span class="icon-badge">&#127974;</span>
      <span class="title">Transactions by Account Type</span>
    </div>
    <div class="section-body">
      <div class="acct-grid">
        <div>
          <div class="table-scroll">
          <table>
            <thead><tr><th>Account Type</th><th>Count</th><th></th></tr></thead>
            <tbody id="acctBody"></tbody>
            <tfoot id="acctFoot"></tfoot>
          </table>
          </div>
          <button class="add-row-btn edit-only" id="addAcctBtn">+ Add Account Type</button>
        </div>
        <div class="bar-list" id="acctBarList"></div>
      </div>
    </div>
  </div>

  <div class="section" id="customSection">
    <div class="section-header" onclick="toggleSection('customSection')">
      <span class="chevron">&#9660;</span>
      <span class="icon-badge">&#129513;</span>
      <span class="title">Custom Tables</span>
    </div>
    <div class="section-body">
      <div id="customTablesHost"></div>
      <button class="add-row-btn edit-only" id="addTableBtn">+ New Table</button>
    </div>
  </div>

</main>

<footer>Interactive report &middot; edits are saved locally in this browser &middot; unlock editing to make changes, then Publish to share them
  &middot; <span id="lockViewLink" style="cursor:pointer;text-decoration:underline;">Lock report view</span>
</footer>

</div>

<script>
const ORIGINAL_STATE = /*STATE_START*/{
"monthly":[{"month":"Jan","users":1797,"trxs":8431,"amount":338079011,"custom":{}},{"month":"Feb","users":1689,"trxs":8168,"amount":233606811.5,"custom":{}},{"month":"Mar","users":1686,"trxs":7994,"amount":359138804.5,"custom":{}},{"month":"Apr","users":1670,"trxs":8199,"amount":544107632.5,"custom":{}},{"month":"May","users":1649,"trxs":7831,"amount":419124928.7,"custom":{}},{"month":"June","users":1704,"trxs":8212,"amount":895703475.4,"custom":{}}],
"customColumns":[],
"acct":[{"type":"ADA Corporate Customer","count":218},{"type":"ADA Customer","count":767},{"type":"Corporate Account Master Wallet","count":3560},{"type":"Corporate Sim Sim Account User","count":3479},{"type":"L0 AMA BVS Verified","count":12},{"type":"L1","count":4109},{"type":"L1 Corporate SimSim User","count":3474},{"type":"L2 Existing Customer","count":4529},{"type":"L2 Individual Staff","count":5352},{"type":"L2 Individual Staff-700000","count":78},{"type":"L2-Individual","count":1250},{"type":"L2-Individual-99999","count":2}],
"customTables":[],
"insights":[
