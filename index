function renderBulletList(containerId, arr, onChange){
  const el = document.getElementById(containerId);
  el.innerHTML = arr.map((text, i) => `
    <li class="bullet-row">
      <span class="bullet-dot">${i+1}</span>
      <textarea class="bullet-input" data-idx="${i}" rows="2">${esc(text)}</textarea>
      <span class="row-del edit-only" onclick="${containerId}_delete(${i})">&times;</span>
    </li>`).join('');
  el.querySelectorAll('textarea').forEach(ta => {
    autoSize(ta);
    ta.addEventListener('input', () => {
      arr[ta.dataset.idx] = ta.value;
      autoSize(ta);
      onChange();
    });
  });
}

